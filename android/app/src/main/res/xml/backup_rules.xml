<?xml version="1.0" encoding="utf-8"?>
<!-- Pre-Android-12 counterpart of data_extraction_rules.xml: the stored
     bearer token must not leave the device through adb/cloud backup. -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="file" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
