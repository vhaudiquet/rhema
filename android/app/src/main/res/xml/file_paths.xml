<?xml version="1.0" encoding="utf-8"?>
<!-- The cache subtree saved attachments land in before an ACTION_VIEW
     hand-off; FileProvider maps files under it to content:// uris. -->
<paths>
    <cache-path name="attachments" path="attachments/" />
    <!-- Camera shots stage here before a send: TakePicture writes straight
         into the FileProvider-mapped content:// uri (no CAMERA permission). -->
    <cache-path name="camera" path="camera/" />
</paths>
